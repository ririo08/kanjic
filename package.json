{
  "name": "kanjic",
  "version": "0.1.4",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "devDependencies": {
    "tsdown": "^0.21.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  },
  "private": false,
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "bun run lint --fix",
    "build": "tsdown",
